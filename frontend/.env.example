# Copy to .env.local and fill in for local dev. Vite only exposes
# variables prefixed VITE_ to client code, and only reads this file at
# build/dev-server start (restart `npm run dev` after changing it).

# Base URL of the backend API. Empty (the default, i.e. leave this unset)
# means same-origin — correct once frontend and backend share a domain.
# For local dev, point it at the backend's own dev server:
VITE_API_BASE_URL=http://localhost:8000
