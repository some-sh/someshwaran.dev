# Keeps the build context small and avoids baking in host-machine state
# (venvs, node_modules, caches) that the Dockerfile installs fresh anyway.
.git/
.github/

**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

backend/.venv/
backend/data/
backend/*.db
# NOTE: backend/frontend_dist/ is deliberately NOT ignored. scripts/deploy.sh
# uploads the repo root to FastAPI Cloud with that directory inside it, and
# the remote image build appears to honor this file: listing it here made the
# deploy succeed while shipping without the frontend (/health reported
# frontend_mounted: false). The Docker fallback is unaffected in practice: its
# own frontend stage copies fresh files over ./frontend_dist.

frontend/node_modules/
frontend/dist/
frontend/coverage/

e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
