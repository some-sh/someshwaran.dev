# Copy to .env and fill in real values. .env itself is gitignored.

# Shared secret for the one admin auth mechanism (app/core/security.py),
# used by both the admin web routes and (from phase 7) the MCP server.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ADMIN_API_KEY=

# Database. Leave unset for local dev: it defaults to SQLite at ./data/app.db.
# In production this must be Postgres (SQLite on the container's filesystem is
# wiped by every deploy). The FastAPI Cloud <-> Neon integration sets the
# plain DATABASE_URL for you; APP_DATABASE_URL (this name) wins if both exist.
# postgres:// and postgresql:// URLs are accepted as-is.
# APP_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Interactive API docs (/docs, /redoc, /openapi.json) are OFF by default because
# on a public deployment they list every admin route. Turn them on locally:
# APP_ENABLE_DOCS=true
